# Public HTTPS URL of this server (no trailing slash). Use an ngrok URL in development.
APP_URL=https://paddle-pay-connect.vercel.app
PORT=3000

# Postgres. On Vercel these come from Prisma Postgres (connected with prefix "DATABASE").
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_POOLED=postgresql://user:pass@host/db?sslmode=require

# 32-byte key (64 hex chars) used to encrypt tokens/keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Secret used to sign settings-page sessions. Any long random string.
SESSION_SECRET=

# ---- HighLevel Marketplace app (Advanced Settings > Auth) ----
GHL_CLIENT_ID=6ae4078802073d9ed3244ab5-mvugoxyv
GHL_CLIENT_SECRET=
# Shared Secret / SSO key used to decrypt user data on custom pages
GHL_SSO_KEY=
# Your marketplace app ID (the part before "-" in the client id is usually the app id)
GHL_APP_ID=6ae4078802073d9ed3244ab5
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
# Optional: PEM public key from GHL docs for verifying x-wh-signature on app webhooks
GHL_WEBHOOK_PUBLIC_KEY=

# How the provider appears inside GHL
PROVIDER_NAME=Paddle Pay
PROVIDER_DESCRIPTION=Accept payments with Paddle (Merchant of Record)
PROVIDER_IMAGE_URL=https://paddle-pay-connect.vercel.app/logo.svg

# ---- Public website / legal pages (Paddle reviews these for domain approval) ----
BUSINESS_NAME=IR Solutions
BUSINESS_ADDRESS=Muzaffargarh, Punjab, Pakistan
SUPPORT_EMAIL=

# ---- Merchant checkout domains (pay.merchant.com) ----
# Vercel access token (Account Settings > Tokens) scoped to the team that owns the project.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID_OR_NAME=paddle-pay-connect
VERCEL_TEAM_ID=team_SDPilIucZUn6vCEdxETTfpkl
